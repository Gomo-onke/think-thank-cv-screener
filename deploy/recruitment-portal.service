# /etc/systemd/system/recruitment-portal.service
[Unit]
Description=Think Tank Software Solutions Recruitment Portal (gunicorn)
After=network.target

[Service]
User=portal
Group=www-data
WorkingDirectory=/opt/recruitment-portal
EnvironmentFile=/opt/recruitment-portal/.env
ExecStart=/opt/recruitment-portal/.venv/bin/gunicorn app:app --bind 127.0.0.1:8000 --workers 2 --timeout 60
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
